# supabase start 출력값으로 채웁니다. (pnpm supabase:status 로 다시 확인 가능)

# Prisma -> 로컬 Supabase Postgres 직결
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres"

# 브라우저에 노출되는 값
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=""

# Hero 우측 대표 강사 사진. 인물 사진은 초상권 때문에 저장소에 포함하지 않는다.
# public/ 에 파일을 두고 경로를 지정하면 그때만 렌더된다. 비워 두면 플레이스홀더.
NEXT_PUBLIC_HERO_IMAGE=""
